{
  "manifest_version": 3,
  "name": "GitHub Repo Insights Pro",
  "short_name": "Repo Insights",
  "version": "1.0.0",
  "description": "بطاقة تحليلات احترافية داخل صفحات GitHub: نقاط صحة المستودع، المساهمون، الرخصة، والنشاط الأخير — تظهر تلقائيًا وأنت بتتصفح أي مستودع.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GitHub Repo Insights Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
